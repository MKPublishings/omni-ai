{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@/engines/*": ["src/engines/*"],
      "@/api/*": ["src/api/*"],
      "@/tools/*": ["src/tools/*"],
      "@/types/*": ["src/types/*"],
      "@/schemas/*": ["src/schemas/*"],
      "@/middleware/*": ["src/middleware/*"],
      "@/*": ["src/*"]
      },
  },
  "include": ["src/**/*", "worker-configuration.d.ts"]
}

