{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ION-ai.local/schemas/blackwell-agent-profiles.schema.json",
  "title": "Blackwell Agent Profiles",
  "type": "object",
  "required": [
    "version",
    "agents"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "v1"
      ]
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "department",
          "ritual",
          "handoff_targets"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "Engineer",
              "Synthesizer",
              "Archivist",
              "Analyst",
              "Manager"
            ]
          },
          "department": {
            "type": "string",
            "enum": [
              "Research",
              "Ops",
              "Finance",
              "Creative",
              "Infra",
              "All"
            ]
          },
          "ritual": {
            "type": "string",
            "minLength": 1
          },
          "handoff_targets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
