{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build ION Image Engine",
      "type": "shell",
      "command": "npm run lint --if-present; npm run test --if-present; npm run typecheck --if-present; node ./ION-image-engine/utils/validator.js; Write-Output 'Core modules are JS and do not require bundling in current setup.'",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Dev Mode",
      "type": "shell",
      "command": "Write-Output 'Dev mode started: edit core/style configs for hot updates in your app runtime.'; Write-Output 'Use promptDiffViewer.js from UI integration to inspect prompt evolution.'",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "ION: Mind Loop on Recent Logs",
      "type": "shell",
      "command": "node ./scripts/mind/runOnRecentLogs.js",
      "problemMatcher": []
    },
    {
      "label": "ION: Auto-Debug",
      "type": "shell",
      "command": "node ./scripts/tools/runAutoDebug.js",
      "problemMatcher": []
    },
    {
      "label": "ION: Test Image Contract",
      "type": "shell",
      "command": "npm run test:image-contract",
      "problemMatcher": []
    },
    {
      "label": "ION: Test Image Queue Contract",
      "type": "shell",
      "command": "npm run test:image-queue-contract",
      "problemMatcher": []
    },
    {
      "label": "ION: Smoke Orchestrator Image-Gen Route",
      "type": "shell",
      "command": "npm run smoke:image:orchestrator-attestation:image-gen",
      "problemMatcher": []
    },
    {
      "label": "ION: View Task Tokens",
      "type": "shell",
      "command": "node ./scripts/tools/printTaskTokens.js",
      "problemMatcher": []
    },
    {
      "label": "ION: Set Task Token Status",
      "type": "shell",
      "command": "Write-Output 'Usage: npm run mind:tokens:set -- <tokenId> <open|in-progress|resolved>'",
      "problemMatcher": []
    },
    {
      "label": "ION: View Active Task Tokens",
      "type": "shell",
      "command": "node ./scripts/tools/printActiveTaskTokens.js",
      "problemMatcher": []
    },
    {
      "label": "ION: Next Actionable Task Token",
      "type": "shell",
      "command": "node ./scripts/tools/printNextTaskToken.js",
      "problemMatcher": []
    },
    {
      "label": "ION: Maintain Task Token Queue",
      "type": "shell",
      "command": "node ./scripts/tools/runTaskTokenMaintenance.js",
      "problemMatcher": []
    },
    {
      "label": "Start ComfyUI Server",
      "type": "shell",
      "command": "${workspaceFolder}/server.bat",
      "options": {
        "envFile": "${workspaceFolder}/.env"
      },
      "problemMatcher": [],
      "isBackground": false
    },
    {
      "label": "Start ComfyUI (GPU)",
      "type": "shell",
      "command": "${workspaceFolder}/server_gpu.bat",
      "options": {
        "envFile": "${workspaceFolder}/.env"
      },
      "problemMatcher": [],
      "isBackground": false
    },
    {
      "label": "Start ComfyUI GPU Server",
      "type": "shell",
      "command": "C:/ComfyUI/ComfyUI/start-ion.bat",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Warmup GPU",
      "type": "shell",
      "command": "python C:/ComfyUI/ComfyUI/warmup.py",
      "problemMatcher": []
    }
  ]
}
