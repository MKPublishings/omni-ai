registry=https://registry.npmjs.org/
strict-ssl=true

# Harden dependency installation against transient network resets in CI/build agents.
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000

# Lower concurrent sockets to reduce connection churn on shared build networks.
maxsockets=12

# Reduce non-essential network calls during install.
audit=false
fund=false
progress=false
