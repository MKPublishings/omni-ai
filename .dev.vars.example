# Local development variables for Wrangler (`wrangler dev`).
# Copy this file to `.dev.vars` and fill in real secrets/values.

# ===== Worker runtime =====
ION_ENV="development"
# For Cloudflare deployment use your media worker URL, e.g.:
# ION_MEDIA_API_BASE_URL="https://ion-ai-media.ion-ai.workers.dev"
ION_MEDIA_API_BASE_URL="http://127.0.0.1:8788"
ION_MEDIA_API_KEY="replace-with-ion-media-key"
ION_MEDIA_API_TIMEOUT_MS="45000"

# Optional admin protection for maintenance endpoints.
ION_ADMIN_KEY="replace-with-strong-secret"

# Optional model aliases.
MODEL_ION="@cf/meta/llama-3.1-8b-instruct"

# ===== ION media service (Python process) =====
# Use the same key as ION_MEDIA_API_KEY when API key auth is enabled.
ION_MEDIA_API_KEYS="replace-with-ion-media-key"
ION_MEDIA_HOST="127.0.0.1"
ION_MEDIA_PORT="8788"
