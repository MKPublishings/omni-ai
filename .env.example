# ION Glass UI System - Environment Configuration

# JWT Authentication
JWT_SECRET=your-super-secure-jwt-secret-here

# ION AI API
ION_API_KEY=your-ion-ai-api-key
ION_API_BASE_URL=https://ion-ai.ion-ai.workers.dev/

# Dashboard Configuration
NEXT_PUBLIC_APP_NAME="ION AI Dashboard"
NEXT_PUBLIC_APP_VERSION="1.0.0"
# Replace with the deployed Worker origin that serves /api/ION and /api/gateway/status.
NEXT_PUBLIC_ION_API_URL="https://your-ion-api-worker.workers.dev"
# Auth0 React SDK (client-side only in the Next.js app)
NEXT_PUBLIC_AUTH0_DOMAIN="ion-ai.us.auth0.com"
NEXT_PUBLIC_AUTH0_CLIENT_ID="tlXPaqF8p70rPlIbKkKyEOXXJPjenTxf"
# This Auth0 application is currently configured only for https://ionirix.com/
NEXT_PUBLIC_AUTH0_APP_ORIGIN="https://ionirix.com"
# Optional: provider start endpoints. The dashboard app appends next/callback parameters and expects the auth service
# to redirect back to /auth/callback with either an auth payload or token/sessionId/expiresAt/user fields.
NEXT_PUBLIC_GOOGLE_AUTH_URL="https://your-ion-api-worker.workers.dev/api/auth/google/start"
NEXT_PUBLIC_X_AUTH_URL=""
NEXT_PUBLIC_STRIPE_PREMIUM_MONTHLY_PRICE_ID="price_1TN0JIBJEKcExtO66AR2kxnp"
NEXT_PUBLIC_STRIPE_PREMIUM_YEARLY_PRICE_ID="price_1TN0OwBJEKcExtO6XWK1617l"
NEXT_PUBLIC_STRIPE_ENTERPRISE_MONTHLY_PRICE_ID="price_1TN0SrBJEKcExtO6DpypdWEA"
NEXT_PUBLIC_STRIPE_ENTERPRISE_YEARLY_PRICE_ID="price_1TN0W9BJEKcExtO6hpAoVcmV"

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id

# Security
NEXT_PUBLIC_CSP_ENABLED=true
NEXT_PUBLIC_HSTS_ENABLED=true

# Performance
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_SW_PATH=/sw.js