# ION Glass UI System - Environment Configuration

# JWT Authentication
JWT_SECRET=your-super-secure-jwt-secret-here

# ION AI API
ION_API_KEY=your-ion-ai-api-key
ION_API_BASE_URL=https://ion-ai.ion-ai.workers.dev/

# Dashboard Configuration
NEXT_PUBLIC_APP_NAME="ION AI Dashboard"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_ION_API_URL="https://ion-ai.omni-ai.workers.dev"

# Analytics (optional)
NEXT_PUBLIC_ANALYTICS_ID=your-analytics-id

# Security
NEXT_PUBLIC_CSP_ENABLED=true
NEXT_PUBLIC_HSTS_ENABLED=true

# Performance
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_SW_PATH=/sw.js