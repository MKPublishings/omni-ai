{
  "name": "landscape_pipeline",
  "version": "1.0.0",
  "description": "Landscape correction chain for texture diversity, atmospheric layering, and shadow refinement.",
  "nodes": [
    { "id": "base_ksampler", "type": "KSampler", "sampler": "dpmpp_2m_karras", "steps": 24 },
    { "id": "texture_randomizer", "type": "TextureRandomizer", "roughness_jitter": 0.2 },
    { "id": "atmospheric_fog", "type": "AtmosphericFog", "fog_density": 0.15 },
    { "id": "shadow_softener", "type": "ShadowSoftener", "shadow_softness": 0.6 },
    { "id": "vae_decode", "type": "VAEDecode" },
    { "id": "composition_rhythm", "type": "CompositionRhythmGenerator", "object_variation": "poisson_disk" },
    { "id": "postfx_chain", "type": "PostFXChain", "ref": "postfx_chain.json" }
  ],
  "parameters": {
    "roughness_jitter": 0.2,
    "fog_density": 0.15,
    "shadow_softness": 0.6,
    "object_variation": "poisson_disk"
  }
}
