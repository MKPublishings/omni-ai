{
  "name": "ION-mind-os",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "hierarchy:dev": "npm --prefix ./ionirix-hierarchy run dev",
    "hierarchy:validate": "npm --prefix ./ionirix-hierarchy run validate",
    "hierarchy:audit": "npm --prefix ./ionirix-hierarchy run audit",
    "hierarchy:typecheck": "npm --prefix ./ionirix-hierarchy run typecheck",
    "hierarchy:test": "npm --prefix ./ionirix-hierarchy run test",
    "dev:media": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev/start-media-and-worker.ps1",
    "dev:media:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev/start-media-and-worker.ps1 -Local",
    "deploy": "node ./scripts/deploy.js",
    "deploy:dashboard": "node ./scripts/deploy.js dashboard",
    "deploy:worker": "node ./scripts/deploy.js worker",
    "preview": "wrangler dev --local",
    "lint": "npm run lint:code && npm run check:branding",
    "lint:code": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "check:branding": "node ./scripts/check-branding.js",
    "build": "node ./scripts/build.js",
    "test": "npm run smoke:image && npm run smoke:image:worker && npm run smoke:chat-policy && npm run smoke:chat-image-intent && npm run smoke:policy-lockstep && npm run smoke:image:orchestrator-attestation && npm run test:runtime && npm run test:cosmic && npm run test:multiverse",
    "test:dashboard:e2e": "npm run build --workspace @ionirix/dashboard && playwright test -c apps/dashboard/playwright.config.ts",
    "test:runtime": "tsx --test src/runtime/tests/simulationEngine.test.ts src/runtime/tests/simulationWorker.test.ts src/runtime/tests/router.test.ts src/runtime/tests/modeRouting.test.ts src/runtime/tests/runtimeLoop.test.ts src/runtime/tests/workerRoute.test.ts src/runtime/tests/worldBridge.test.ts src/runtime/tests/worldWorker.test.ts src/runtime/tests/ionGateway.test.ts src/runtime/tests/premiumContracts.test.ts src/runtime/tests/stripeBilling.test.ts",
    "test:cosmic": "tsx --test src/modes/cosmic/__tests__/gravitational.test.ts src/modes/cosmic/__tests__/dynamics.test.ts src/modes/cosmic/__tests__/stellar.test.ts src/modes/cosmic/__tests__/ism.test.ts src/modes/cosmic/__tests__/integration.test.ts",
    "test:multiverse": "tsx --test src/modes/multiverse/__tests__/multiverse_seed.test.ts",
    "test:cross-browser": "node ./scripts/test-cross-browser.js",
    "typecheck": "tsc -p tsconfig.json",
    "smoke:image": "node ./ION-image-engine/utils/smokeTest.js && node ./ION-image-engine/utils/policySmokeTest.js",
    "smoke:image:worker": "node ./scripts/smoke/imageWorkerContractSmoke.js",
    "smoke:image:orchestrator-attestation": "node ./scripts/smoke/orchestratorImageAttestationSmoke.js",
    "smoke:premium-phase": "node ./scripts/smoke/premiumPhaseRouteSmoke.js",
    "smoke:chat-policy": "node ./scripts/smoke/chatPromptPolicySmoke.js",
    "smoke:chat-image-intent": "node ./scripts/smoke/chatImageIntentSmoke.js",
    "validate:dashboard-api": "node ./scripts/tools/checkDashboardApiBase.js",
    "bench:chat-latency": "node ./scripts/bench/chatLatency.js",
    "smoke:policy-lockstep": "node ./scripts/smoke/policyLockstepSmoke.js",
    "validate:engine": "node ./ION-image-engine/utils/validator.js",
    "mind:loop": "node ./scripts/mind/runOnRecentLogs.js",
    "mind:baseline": "node ./scripts/mind/runBaselineIntelligence.js",
    "mind:readiness": "node ./scripts/mind/runShipReadiness.js",
    "mind:readiness:strict": "node ./scripts/mind/runShipReadiness.js --strict",
    "mind:auto-debug": "node ./scripts/tools/runAutoDebug.js",
    "billing:check-config": "tsx src/scripts/check-billing-config.ts",
    "forensics:image": "node ./scripts/tools/runImageForensicsSweep.js",
    "forensics:image:strict": "node ./scripts/tools/runImageForensicsSweep.js --strict",
    "mind:tokens": "node ./scripts/tools/printTaskTokens.js",
    "mind:tokens:set": "node ./scripts/tools/updateTaskTokenStatus.js",
    "mind:tokens:active": "node ./scripts/tools/printActiveTaskTokens.js",
    "mind:tokens:next": "node ./scripts/tools/printNextTaskToken.js",
    "mind:tokens:next:claim": "node ./scripts/tools/printNextTaskToken.js --claim",
    "mind:tokens:maintain": "node ./scripts/tools/runTaskTokenMaintenance.js",
    "world:bridge:serve": ".\\.venv\\Scripts\\python.exe -m ION_ai.world.run_server",
    "sim:quantum:export": ".\\.venv\\Scripts\\python.exe ./ION_media/quantum_cognitive_sim.py --csv-out ./data/evaluations/quantum_cognitive_sim_latest.csv --json-out ./data/evaluations/quantum_cognitive_sim_latest.json",
    "codex:reindex": "node ./scripts/codex/reindex.js",
    "codex:register": "node ./scripts/codex/registerArtifact.js",
    "codex:watch": "node ./scripts/codex/watch.js",
    "db:migrate": "tsx src/scripts/migrate-d1.ts --local",
    "db:migrate:remote": "tsx src/scripts/migrate-d1.ts --remote",
    "db:seed:specs": "tsx src/scripts/sync-specs-from-codex.ts",
    "db:seed:tools": "tsx src/scripts/seed-tools.ts",
    "auth:backfill:auth0": "tsx src/scripts/backfill-auth0-users.ts --local",
    "auth:backfill:auth0:remote": "tsx src/scripts/backfill-auth0-users.ts --remote",
    "db:reset": "npm run db:migrate && npm run db:seed:specs && npm run db:seed:tools",
    "v2:setup": "npm run db:migrate && npm run db:seed:specs && npm run db:seed:tools"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.13.4",
    "eslint": "^10.0.2",
    "globals": "^17.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  }
}
