{
  "minOutputSide": 256,
  "maxOutputSide": 8192,
  "defaultModel": "ION_worker",
  "models": {
    "ION_worker": {
      "name": "ION Worker Image Generator",
      "type": "image",
      "provider": "ion-worker",
      "endpoint": "https://ionirix.com/api/image",
      "defaultWidth": 2160,
      "defaultHeight": 3840,
      "defaultSteps": 28,
      "defaultCfgScale": 5,
      "optimizedFor": ["general", "photorealistic", "anime"]
    }
  },
  "animeOptimizations": {
    "ION_anime_optimized": {
      "name": "ION Anime Optimizer",
      "description": "Anime optimization presets for ION_worker model",
      "baseModel": "ION_worker",
      "defaultSteps": 32,
      "defaultCfgScale": 7,
      "samplerPreset": "anime-optimized",
      "denoisingStrength": 0.65,
      "upscalerType": "line-preserve",
      "colorBleedClamp": true,
      "lineworkPreservation": true
    }
  },
  "samplerPresets": {
    "anime-optimized": {
      "name": "Anime Optimized",
      "sampler": "DPM++ 2M Karras",
      "scheduler": "karras",
      "denoisingStrength": 0.65,
      "guidance": 7.0,
      "steps": 32,
      "notes": "Tuned for anime: slightly higher guidance, lower denoising to preserve linework"
    },
    "anime-cel-shading": {
      "name": "Cel Shading",
      "sampler": "Euler A",
      "scheduler": "normal",
      "denoisingStrength": 0.70,
      "guidance": 8.0,
      "steps": 28,
      "colorClamp": true,
      "notes": "For crisp cel-shading with flat color blocks"
    },
    "anime-soft-glow": {
      "name": "Soft Glow",
      "sampler": "DPM++ 2M Karras",
      "scheduler": "karras",
      "denoisingStrength": 0.55,
      "guidance": 6.0,
      "steps": 30,
      "diffusionBoost": true,
      "notes": "Soft, dreamy aesthetic with light diffusion"
    }
  },
  "upscalers": {
    "default": {
      "name": "Default ESRGAN",
      "type": "general",
      "preservesLines": false
    },
    "line-preserve": {
      "name": "Line-Preserve Upscaler",
      "type": "anime",
      "preservesLines": true,
      "edgeSharpening": true,
      "description": "Upscaler that maintains crisp linework and edge definition for anime"
    },
    "soft-blend": {
      "name": "Soft Blend Upscaler",
      "type": "anime-soft",
      "preservesLines": false,
      "colorSmoothing": true,
      "description": "For soft-glow and watercolor anime styles"
    }
  },
  "styleToModelRouting": {
    "anime_cel_shading": {
      "model": "ION_worker",
      "sampler": "anime-cel-shading",
      "upscaler": "line-preserve",
      "animeOptimization": "ION_anime_optimized"
    },
    "anime_soft_glow": {
      "model": "ION_worker",
      "sampler": "anime-soft-glow",
      "upscaler": "soft-blend",
      "animeOptimization": "ION_anime_optimized"
    },
    "anime_90s_retro": {
      "model": "ION_worker",
      "sampler": "anime-optimized",
      "upscaler": "line-preserve",
      "animeOptimization": "ION_anime_optimized"
    },
    "anime_manga_ink": {
      "model": "ION_worker",
      "sampler": "anime-optimized",
      "upscaler": "line-preserve",
      "animeOptimization": "ION_anime_optimized"
    },
    "anime_chibi": {
      "model": "ION_worker",
      "sampler": "anime-cel-shading",
      "upscaler": "line-preserve",
      "animeOptimization": "ION_anime_optimized"
    },
    "anime_shoujo": {
      "model": "ION_worker",
      "sampler": "anime-soft-glow",
      "upscaler": "soft-blend",
      "animeOptimization": "ION_anime_optimized"
    },
    "anime_shounen": {
      "model": "ION_worker",
      "sampler": "anime-cel-shading",
      "upscaler": "line-preserve",
      "animeOptimization": "ION_anime_optimized"
    },
    "anime_mecha": {
      "model": "ION_worker",
      "sampler": "anime-optimized",
      "upscaler": "line-preserve",
      "animeOptimization": "ION_anime_optimized"
    },
    "anime_isekai": {
      "model": "ION_worker",
      "sampler": "anime-optimized",
      "upscaler": "default",
      "animeOptimization": "ION_anime_optimized"
    }
  }
}

