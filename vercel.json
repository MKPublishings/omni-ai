{
  "version": 2,
  "builds": [
    {
      "src": "apps/dashboard/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/apps/dashboard/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/apps/dashboard/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_AUTH0_DOMAIN": "ion-ai.us.auth0.com",
    "NEXT_PUBLIC_AUTH0_CLIENT_ID": "tlXPaqF8p70rPlIbKkKyEOXXJPjenTxf",
    "NEXT_PUBLIC_AUTH0_APP_ORIGIN": "https://ionirix.com"
  }
}